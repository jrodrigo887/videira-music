generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                    String                 @id
  slug                  String                 @unique
  name                  String
  stripeCustomerId      String?                @unique
  subscriptionStatus    String                 @default("none")
  currentPeriodEnd      DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  songs                 Song[]
  charts                ChordChart[]
  users                 User[]
  teams                 WorshipTeam[]
  setlists              Setlist[]
  invites               Invite[]
  roleDefinitions       RoleDefinition[]
  accessRequests        AccessRequest[]
  chartSuggestions      ChartSuggestion[]
  capabilityDelegations CapabilityDelegation[]
}

model User {
  id                       String                 @id
  organizationId           String
  organization             Organization           @relation(fields: [organizationId], references: [id])
  authUserId               String?                @unique
  name                     String
  email                    String
  status                   String                 @default("active")
  deactivatedAt            DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  roles                    UserRole[]
  teamMemberships          WorshipTeamMember[]
  invitesCreated           Invite[]               @relation("InviteCreatedBy")
  songsCreated             Song[]                 @relation("SongCreatedBy")
  chartsCreated            ChordChart[]           @relation("ChartCreatedBy")
  chartsLastEdited         ChordChart[]           @relation("ChartLastEditedBy")
  setlistsCreated          Setlist[]              @relation("SetlistCreatedBy")
  chartRevisionsSaved      ChordChartRevision[]   @relation("ChartRevisionSavedBy")
  chartSuggestionsAuthored ChartSuggestion[]      @relation("ChartSuggestionAuthor")
  chartSuggestionsReviewed ChartSuggestion[]      @relation("ChartSuggestionReviewer")
  setlistShareLinksCreated SetlistShareLink[]     @relation("SetlistShareLinkCreatedBy")
  delegationsGranted       CapabilityDelegation[] @relation("DelegationGrantor")
  delegationsReceived      CapabilityDelegation[] @relation("DelegationGrantee")
  viewAsSessionsAsViewer   ViewAsSession[]        @relation("ViewAsViewer")
  viewAsSessionsAsTarget   ViewAsSession[]        @relation("ViewAsTarget")

  @@unique([organizationId, email])
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   String

  @@id([userId, role])
  @@index([role])
}

model AuthUser {
  id            String        @id
  name          String
  email         String
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      AuthSession[]
  accounts      AuthAccount[]

  @@unique([email])
  @@map("auth_user")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("auth_session")
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String
  userId                String
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@map("auth_account")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("auth_verification")
}

model RoleDefinition {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  key            String
  label          String
  system         Boolean      @default(false)
  capabilities   Json         @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId])
}

model AccessRequest {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  email            String
  name             String
  status           String       @default("pending")
  requestedAt      DateTime     @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?
  createdUserId    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, email])
  @@index([organizationId, status])
}

model Invite {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  email           String
  tokenHash       String       @unique
  roles           Json
  teamIds         Json
  expiresAt       DateTime
  createdByUserId String
  createdBy       User         @relation("InviteCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime     @default(now())
  usedAt          DateTime?
  usedByUserId    String?
  revokedAt       DateTime?

  @@index([organizationId, email])
}

model AuthAuditLog {
  id           String   @id @default(cuid())
  occurredAt   DateTime @default(now())
  actorUserId  String?
  action       String
  targetUserId String?
  targetEmail  String?
  details      Json?

  @@index([occurredAt])
}

model WorshipTeam {
  id             String              @id
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  slug           String
  name           String
  archivedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  members        WorshipTeamMember[]
  ownedSetlists  Setlist[]
  setlistFollows SetlistFollow[]

  @@unique([organizationId, slug])
}

model WorshipTeamMember {
  teamId    String
  team      WorshipTeam @relation(fields: [teamId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  role      String
  createdAt DateTime    @default(now())

  @@id([teamId, userId])
  @@index([userId])
}

model Song {
  id                   String        @id
  organizationId       String
  organization         Organization  @relation(fields: [organizationId], references: [id])
  title                String
  label                String
  artist               String?
  genre                String?
  defaultKey           String?
  alternateKeys        Json
  notes                String?
  meta                 String
  searchText           String
  publicLyrics         Boolean       @default(false)
  sourceOrganizationId String?
  deletedAt            DateTime?
  createdByUserId      String?
  createdBy            User?         @relation("SongCreatedBy", fields: [createdByUserId], references: [id])
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  charts               ChordChart[]
  setlistItems         SetlistItem[]

  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

model ChordChart {
  id                   String               @id
  organizationId       String
  organization         Organization         @relation(fields: [organizationId], references: [id])
  songId               String
  song                 Song                 @relation(fields: [songId], references: [id])
  title                String?
  versionLabel         String?
  format               String
  key                  String
  timeSignature        String
  tempo                Int?
  capo                 Int?
  sections             Json
  source               String?
  origin               Json?
  originUrl            String?
  sourceOrganizationId String?
  schemaVersion        Int                  @default(1)
  createdByUserId      String?
  createdBy            User?                @relation("ChartCreatedBy", fields: [createdByUserId], references: [id])
  lastEditedByUserId   String?
  lastEditedBy         User?                @relation("ChartLastEditedBy", fields: [lastEditedByUserId], references: [id])
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  setlistItems         SetlistItem[]
  revisions            ChordChartRevision[]
  suggestions          ChartSuggestion[]

  @@unique([organizationId, originUrl])
  @@index([organizationId, songId])
}

model Setlist {
  id              String             @id
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id])
  ownerTeamId     String?
  ownerTeam       WorshipTeam?       @relation(fields: [ownerTeamId], references: [id])
  ownerUserId     String?
  title           String
  eventType       String?
  eventAt         DateTime?
  status          String
  visibility      String
  notes           String?
  version         Int                @default(1)
  deletedAt       DateTime?
  createdByUserId String?
  createdBy       User?              @relation("SetlistCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  items           SetlistItem[]
  follows         SetlistFollow[]
  shareLinks      SetlistShareLink[]

  @@index([organizationId, ownerTeamId])
}

model SetlistItem {
  id          String      @id
  setlistId   String
  setlist     Setlist     @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  position    Int
  kind        String
  songId      String?
  song        Song?       @relation(fields: [songId], references: [id])
  chartId     String?
  chart       ChordChart? @relation(fields: [chartId], references: [id])
  selectedKey String?
  text        String?
  notes       String?

  @@unique([setlistId, position])
  @@index([chartId])
}

model SetlistFollow {
  setlistId String
  setlist   Setlist     @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  teamId    String
  team      WorshipTeam @relation(fields: [teamId], references: [id])
  createdAt DateTime    @default(now())

  @@id([setlistId, teamId])
  @@index([teamId])
}

model ImportLog {
  id         String   @id @default(cuid())
  occurredAt DateTime
  action     String
  outcome    String
  url        String?
  chartId    String?
  userId     String?

  @@index([occurredAt])
}

model ChordChartRevision {
  id            String     @id @default(cuid())
  chartId       String
  chart         ChordChart @relation(fields: [chartId], references: [id], onDelete: Cascade)
  source        String?
  sections      Json
  key           String
  capo          Int?
  versionLabel  String?
  savedByUserId String?
  savedBy       User?      @relation("ChartRevisionSavedBy", fields: [savedByUserId], references: [id])
  savedAt       DateTime   @default(now())

  @@index([chartId, savedAt])
}

model ChartSuggestion {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  chartId          String
  chart            ChordChart   @relation(fields: [chartId], references: [id], onDelete: Cascade)
  authorUserId     String
  author           User         @relation("ChartSuggestionAuthor", fields: [authorUserId], references: [id])
  source           String
  sections         Json
  key              String
  capo             Int?
  status           String
  reviewedByUserId String?
  reviewedBy       User?        @relation("ChartSuggestionReviewer", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([chartId, status])
  @@index([chartId, authorUserId])
}

model SetlistShareLink {
  id              String    @id @default(cuid())
  setlistId       String
  setlist         Setlist   @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  createdByUserId String
  createdBy       User      @relation("SetlistShareLinkCreatedBy", fields: [createdByUserId], references: [id])
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([setlistId])
}

model CapabilityDelegation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  grantorUserId  String
  grantor        User         @relation("DelegationGrantor", fields: [grantorUserId], references: [id])
  granteeUserId  String
  grantee        User         @relation("DelegationGrantee", fields: [granteeUserId], references: [id])
  capabilities   Json
  teamIds        Json
  startsAt       DateTime     @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  reason         String?
  createdAt      DateTime     @default(now())

  @@index([granteeUserId, expiresAt])
}

model ViewAsSession {
  id           String    @id @default(cuid())
  viewerUserId String
  viewer       User      @relation("ViewAsViewer", fields: [viewerUserId], references: [id])
  targetUserId String
  target       User      @relation("ViewAsTarget", fields: [targetUserId], references: [id])
  reason       String
  expiresAt    DateTime
  endedAt      DateTime?
  createdAt    DateTime  @default(now())

  @@index([viewerUserId, endedAt])
}

model BillingEvent {
  id          String   @id
  processedAt DateTime @default(now())
}
