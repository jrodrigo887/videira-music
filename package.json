{
  "name": "videira-music",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "DIRECT_URL=\"${DIRECT_URL:-$DATABASE_URL}\" prisma generate && DIRECT_URL=\"${DIRECT_URL:-$DATABASE_URL}\" prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint app components lib types --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:migrations": "tsx scripts/check-migrations-safe.ts",
    "postinstall": "DIRECT_URL=\"${DIRECT_URL:-$DATABASE_URL}\" prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.0",
    "better-auth": "^1.7.0",
    "cheerio": "1.2.0",
    "next": "^16.4.0",
    "playwright": "1.64.0",
    "prisma": "^6.19.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "0.0.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.4.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "pg": "^8.23.1",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
