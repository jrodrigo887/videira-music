# Required in production. Connection used by the app at runtime.
# On Neon, use the pooled URL: host includes -pooler, and the query includes
# pgbouncer=true&connection_limit=1.
# On Vercel, DATABASE_URL is the only database env var required.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# Optional. Direct URL used by Prisma migrations (prisma migrate deploy).
# When unset, postinstall and build fall back to DATABASE_URL.
# Set this when the host has a separate non-pooled URL (Neon host without -pooler).
# When the host only has one URL, omit this or set it to the same value as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth. BETTER_AUTH_SECRET must be at least 32 characters.
# BETTER_AUTH_URL is the https origin of the app (no path).
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
BETTER_AUTH_URL="https://example.com"

# Google OAuth Web client.
# Redirect URI, production domain only: https://<domain>/api/auth/callback/google
# Vercel preview URLs do not complete Google login.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google account that becomes the first admin in production.
VIDEIRA_BOOTSTRAP_ADMIN_EMAIL="you@example.com"

# Import module (off by default). Requires authenticated user with import permission.
# VIDEIRA_ENABLE_IMPORT=true

# Localhost login switch (local only; ignored in production).
# true  = no Google login; identity is VIDEIRA_SIMULATED_USER_ID, or user-admin when that is empty.
# false = login required, and the simulated user is ignored.
# DEV_LOCALHOST=true

# Simulated auth for local dev/tests (ignored in production). Seeded users: user-admin, user-leader, user-musician.
# VIDEIRA_SIMULATED_USER_ID="user-admin"
